<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>
    <style name="SettingsFragmentStyle">
        <item name="android:background">@color/black</item>
    </style>
    <style name="ToolbarStyle">
        <item name="titleTextColor">@color/white</item>
        <item name="android:textSize">@dimen/toolbar_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="navigationIconTint">@color/white</item>
    </style>
    <style name="SettingsSwitchAndTextViewsStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/settings_textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="drawableTint">@color/white</item>
        <item name="thumbTint">@color/blue</item>
        <item name="trackTint">@color/blue_light</item>
    </style>
    <style name="SearchFragmentStyle">
        <item name="android:background">@color/black</item>
    </style>
    <style name="SearchEditTextStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:textSize">@dimen/search_EditText_textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="drawableTint">@color/black</item>
    </style>
    <style name="SearchIconClearStyle">
        <item name="tint">@color/black</item>
    </style>
    <style name="SearchTrackNameStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/search_track_name_textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="SearchArtistNameAndTrackTimeStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/search_artist_name_and_track_time_textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="tint">@color/white</item>
    </style>
    <style name="SearchImageViewArrowForwardStyle">
        <item name="tint">@color/white</item>
    </style>
    <style name="PlaceholderTextViewStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/placeholder_and_history_TextView_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="SearchReloadClearHistoryAndNewPlaylistButtonsStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/search_placeholder_Button_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/search_placeholder_Button_cornerRadius</item>
    </style>
    <style name="SearchHistoryTextViewStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/placeholder_and_history_TextView_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="PlayerFragmentStyle">
        <item name="android:background">@color/black</item>
    </style>
    <style name="PlayerTrackNameStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/player_track_name_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="PlayerArtistNameStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/player_artist_name_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="PlayerPlaybackProgressStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/player_playback_progress_textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="PlayerTrackDetailsValuesStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/player_track_details_textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="LibraryFragmentStyle">
        <item name="android:background">@color/black</item>
    </style>
    <style name="LibraryTabLayoutStyle">
        <item name="android:background">@color/black</item>
        <item name="tabTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
    </style>
</resources>