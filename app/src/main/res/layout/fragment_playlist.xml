<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlist_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".library.ui.PlaylistFragment"
    style="@style/PlaylistFragmentStyle">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playlist_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playlist_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/playlist_art"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                tools:src="@drawable/placeholder_album_and_playlist_art"/>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/playlist_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PlaylistToolbarStyle"/>

            <TextView
                android:id="@+id/playlist_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/playlist_TextView_and_ImageButton_layout_marginStart"
                android:layout_marginEnd="@dimen/playlist_TextView_layout_marginEnd"
                android:layout_marginTop="@dimen/playlist_name_layout_marginTop"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlist_art"
                style="@style/PlaylistNameStyle"
                tools:text="Best songs 2021"/>

            <TextView
                android:id="@+id/playlist_details_description"
                android:layout_width="0dp"
                app:layout_constraintTop_toBottomOf="@id/playlist_name"
                android:layout_marginStart="@dimen/playlist_TextView_and_ImageButton_layout_marginStart"
                android:layout_marginEnd="@dimen/playlist_TextView_layout_marginEnd"
                android:layout_marginTop="@dimen/playlist_details_description_layout_marginTop"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/PlaylistDetailsStyle"
                tools:text="2022"/>

            <TextView
                android:id="@+id/playlist_details_total_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/playlist_TextView_and_ImageButton_layout_marginStart"
                android:layout_marginTop="@dimen/playlist_details_total_duration_layout_marginTop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlist_details_description"
                style="@style/PlaylistDetailsStyle"
                tools:text="300 минут"/>

            <ImageView
                android:id="@+id/playlist_details_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/ellipse_separator_padding"
                android:src="@drawable/ic_ellipse_separator"
                app:layout_constraintStart_toEndOf="@id/playlist_details_total_duration"
                app:layout_constraintTop_toTopOf="@id/playlist_details_total_duration"
                app:layout_constraintBottom_toBottomOf="@id/playlist_details_total_duration"
                style="@style/PlaylistDetailsStyle"/>

            <TextView
                android:id="@+id/playlist_details_number_of_tracks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/playlist_details_separator"
                app:layout_constraintTop_toTopOf="@id/playlist_details_total_duration"
                style="@style/PlaylistDetailsStyle"
                tools:text="98 треков"/>

            <ImageButton
                android:id="@+id/playlist_button_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/playlist_TextView_and_ImageButton_layout_marginStart"
                android:layout_marginTop="@dimen/playlist_button_share_layout_marginTop"
                android:background="@android:color/transparent"
                app:srcCompat="@drawable/ic_share"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlist_details_total_duration"/>

            <ImageButton
                android:id="@+id/playlist_button_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/playlist_TextView_and_ImageButton_layout_marginStart"
                android:background="@android:color/transparent"
                app:srcCompat="@drawable/ic_menu"
                app:layout_constraintStart_toEndOf="@id/playlist_button_share"
                app:layout_constraintTop_toTopOf="@id/playlist_button_share"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/playlist_info_container_Space_layout_height"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlist_button_share"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/playlist_bottom_sheet_tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/background_bottom_sheet"
        app:behavior_hideable="false"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="@dimen/bottom_sheet_drag_handle_layout_width"
            android:layout_height="@dimen/bottom_sheet_drag_handle_layout_height"
            android:layout_marginTop="@dimen/bottom_sheet_drag_handle_layout_marginTop"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/background_bottom_sheet_drag_handle"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlist_recyclerview_tracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/playlist_bottom_sheet_RecyclerView_tracks_layout_marginTop"
            android:paddingBottom="@dimen/playlist_bottom_sheet_RecyclerView_tracks_paddingBottom"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <TextView
            android:id="@+id/playlist_no_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/playlist_bottom_sheet_no_tracks_in_playlist_message_layout_marginHorizontal"
            android:layout_marginTop="@dimen/playlist_bottom_sheet_no_tracks_in_playlist_message_layout_layout_marginTop"
            android:gravity="center_horizontal"
            android:text="@string/no_tracks_added_to_playlist"
            android:visibility="gone"
            style="@style/PlaceholderTextViewStyle"/>
    </LinearLayout>

    <View android:id="@+id/playlist_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/translucent_black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/playlist_bottom_sheet_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/playlist_bottom_sheet_menu_paddingBottom"
        android:orientation="vertical"
        android:background="@drawable/background_bottom_sheet"
        app:behavior_hideable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="@dimen/bottom_sheet_drag_handle_layout_width"
            android:layout_height="@dimen/bottom_sheet_drag_handle_layout_height"
            android:layout_marginTop="@dimen/bottom_sheet_drag_handle_layout_marginTop"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/background_bottom_sheet_drag_handle"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlist_recyclerview_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/playlist_bottom_sheet_RecyclerView_menu_layout_marginTop"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <TextView
            android:id="@+id/playlist_menu_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/playlist_menu_share_layout_marginTop"
            android:paddingHorizontal="@dimen/playlist_menu_TextView_paddingHorizontal"
            android:paddingVertical="@dimen/playlist_menu_TextView_paddingVertical"
            android:text="@string/share"
            style="@style/PlaylistMenuTextViewStyle"/>

        <TextView
            android:id="@+id/playlist_menu_edit_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/playlist_menu_TextView_paddingHorizontal"
            android:paddingVertical="@dimen/playlist_menu_TextView_paddingVertical"
            android:text="@string/edit_information"
            style="@style/PlaylistMenuTextViewStyle"/>

        <TextView
            android:id="@+id/playlist_menu_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/playlist_menu_TextView_paddingHorizontal"
            android:paddingVertical="@dimen/playlist_menu_TextView_paddingVertical"
            android:text="@string/delete_playlist"
            style="@style/PlaylistMenuTextViewStyle"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>