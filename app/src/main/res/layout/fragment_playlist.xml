<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".library.ui.PlaylistFragment"
    style="@style/PlaylistFragmentStyle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/playlist_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            style="@style/PlaylistToolbarStyle"/>

        <ImageView
            android:id="@+id/playlist_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            android:scaleType="centerCrop"
            tools:src="@drawable/placeholder_album_and_playlist_art"/>

        <TextView
            android:id="@+id/playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlist_art"
            android:layout_marginStart="@dimen/playlist_elements_layout_marginStart"
            android:layout_marginTop="@dimen/playlist_name_layout_marginTop"
            android:maxLines="1"
            android:ellipsize="end"
            style="@style/PlaylistNameStyle"
            tools:text="Best songs 2021"/>

        <TextView
            android:id="@+id/playlist_details_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlist_name"
            android:layout_marginStart="@dimen/playlist_elements_layout_marginStart"
            android:layout_marginTop="@dimen/playlist_details_description_layout_marginTop"
            android:maxLines="1"
            android:ellipsize="end"
            style="@style/PlaylistDetailsStyle"
            tools:text="2022"/>

        <TextView
            android:id="@+id/playlist_details_total_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlist_details_description"
            android:layout_marginStart="@dimen/playlist_elements_layout_marginStart"
            android:layout_marginTop="@dimen/playlist_details_total_duration_layout_marginTop"
            style="@style/PlaylistDetailsStyle"
            tools:text="300 минут"/>

        <ImageView
            android:id="@+id/playlist_details_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/ellipse_separator_padding"
            app:layout_constraintStart_toEndOf="@id/playlist_details_total_duration"
            app:layout_constraintTop_toTopOf="@id/playlist_details_total_duration"
            app:layout_constraintBottom_toBottomOf="@id/playlist_details_total_duration"
            android:src="@drawable/ic_ellipse_separator"
            style="@style/PlaylistDetailsStyle"/>

        <TextView
            android:id="@+id/playlist_details_number_of_tracks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/playlist_details_separator"
            app:layout_constraintTop_toTopOf="@id/playlist_details_total_duration"
            style="@style/PlaylistDetailsStyle"
            tools:text="98 треков"/>

        <ImageButton
            android:id="@+id/playlist_button_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playlist_details_total_duration"
            android:layout_marginStart="@dimen/playlist_elements_layout_marginStart"
            android:layout_marginTop="@dimen/playlist_button_share_layout_marginTop"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_share"/>

        <ImageButton
            android:id="@+id/playlist_button_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/playlist_button_share"
            app:layout_constraintTop_toTopOf="@id/playlist_button_share"
            android:layout_marginStart="@dimen/playlist_elements_layout_marginStart"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_menu"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/playlist_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/background_bottom_sheet"
        app:behavior_hideable="true"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="@dimen/bottom_sheet_drag_handle_layout_width"
            android:layout_height="@dimen/bottom_sheet_drag_handle_layout_height"
            android:layout_marginTop="@dimen/bottom_sheet_drag_handle_layout_marginTop"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/background_bottom_sheet_drag_handle"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlist_recyclerview_tracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/playlist_bottom_sheet_RecyclerView_layout_marginTop"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>