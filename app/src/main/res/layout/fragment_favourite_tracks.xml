<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/LibraryFragmentStyle">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_recyclerview_favourite_tracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_RecyclerView_favourite_tracks_layout_marginTop"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    <LinearLayout
        android:id="@+id/library_empty_library"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/library_empty_library_image_layout_marginTop"
            android:layout_marginBottom="@dimen/library_empty_library_and_no_playlists_images_layout_marginBottom"
            android:layout_gravity="center"
            android:src="@drawable/placeholder_no_results"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_library"
            style="@style/PlaceholderTextViewStyle"/>
    </LinearLayout>
</FrameLayout>